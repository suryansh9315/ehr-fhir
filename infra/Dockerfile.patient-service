FROM node:22-alpine AS builder
WORKDIR /app

COPY package.json ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/patient-service/package.json ./packages/patient-service/

RUN npm install --workspace=packages/shared --workspace=packages/patient-service

COPY packages/shared ./packages/shared
COPY packages/patient-service ./packages/patient-service
COPY tsconfig.json ./

RUN npm run build --workspace=packages/shared
RUN npm run build --workspace=packages/patient-service

FROM node:22-alpine AS runner
WORKDIR /app

COPY --from=builder /app/packages/shared/dist ./packages/shared/dist
COPY --from=builder /app/packages/shared/package.json ./packages/shared/package.json
COPY --from=builder /app/packages/patient-service/dist ./packages/patient-service/dist
COPY --from=builder /app/packages/patient-service/package.json ./packages/patient-service/package.json
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json

EXPOSE 3001
CMD ["node", "packages/patient-service/dist/index.js"]
