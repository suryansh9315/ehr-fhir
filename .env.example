# =============================================================================
# PostgreSQL
# =============================================================================
DATABASE_URL=postgresql://ehr:ehr_local@localhost:5432/ehr
POSTGRES_PASSWORD=ehr_local

# =============================================================================
# Redis
# =============================================================================
REDIS_URL=redis://localhost:6379

# =============================================================================
# MinIO (local S3-compatible object storage)
# =============================================================================
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=ehr-documents
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=minio_local
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio_local

# =============================================================================
# Anthropic
# =============================================================================
ANTHROPIC_API_KEY=sk-ant-...

# =============================================================================
# JWT (local dev auth — replaces Keycloak/Kong in local dev)
# =============================================================================
JWT_SECRET=local-dev-secret-change-in-prod

# =============================================================================
# Epic FHIR — Open Sandbox (no auth, read-only)
# Use for local development without Epic app registration.
# Test patients: https://open.epic.com/MyApps/Endpoints
# =============================================================================
FHIR_BASE_URL=https://fhir.epic.com/interconnect-fhir-oauth/api/FHIR/R4
FHIR_AUTH_TYPE=none

# =============================================================================
# Epic FHIR — SMART Sandbox (client credentials, enables writeback)
# Uncomment after registering an app at https://fhir.epic.com
# See README > Epic App Registration for step-by-step instructions.
# =============================================================================
# FHIR_AUTH_TYPE=smart
# FHIR_CLIENT_ID=your-epic-client-id
# FHIR_PRIVATE_KEY_PATH=./keys/epic-private.pem
# FHIR_TOKEN_URL=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
